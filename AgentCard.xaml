<Window x:Class="ClickyWindows.AgentCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicky Agent"
        Width="384"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <!-- Computer use card, top center of the screen, in the mac panel style. Modes: ask to start a
         task (Allow once / Always allow / Not now), confirm an irreversible step (Yes / No),
         countdown before the first action, and a click-through "working" banner. -->
    <Border Style="{StaticResource PanelBorder}" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.5"/>
        </Border.Effect>

        <StackPanel Margin="16,14">
            <DockPanel>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{StaticResource CursorBlue}">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#3380FF" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock x:Name="BodyText" Margin="16,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondary}"
                       TextWrapping="Wrap" MaxHeight="120" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="HintText" Style="{StaticResource HintText}" Margin="16,6,0,0"/>

            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="ThirdButton" Margin="0,0,8,0" Click="OnThird"/>
                <Button x:Name="SecondButton" Margin="0,0,8,0" Click="OnSecond"/>
                <Button x:Name="FirstButton" Style="{StaticResource AccentButton}" Click="OnFirst"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
