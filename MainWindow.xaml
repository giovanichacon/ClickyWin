<Window x:Class="ClickyWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClickyWindows"
        Width="0" Height="0"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Visibility="Hidden"
        WindowStartupLocation="Manual"
        Left="-9999" Top="-9999"
        ResizeMode="NoResize">
    <!-- Invisible window that keeps the WPF app alive; shortcuts come from the
         low-level keyboard hook (KeyboardHookService). -->
</Window>
