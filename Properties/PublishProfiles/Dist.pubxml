<?xml version="1.0" encoding="utf-8"?>
<!--
  Distribution build for the installer:  dotnet publish -p:PublishProfile=Dist
  Self-contained, so people don't need to install the .NET 10 Desktop Runtime first.
  No ReadyToRun: it made no startup difference here and only adds size.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>publish-dist\</PublishDir>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
