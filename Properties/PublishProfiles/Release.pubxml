<?xml version="1.0" encoding="utf-8"?>
<!--
  Release build for everyday use:  dotnet publish -p:PublishProfile=Release
  ReadyToRun precompiles the app and its libraries, so startup skips most JIT work.
  Framework-dependent (uses the installed .NET 10 Desktop Runtime). WPF can't be trimmed or AOT-compiled.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>publish\</PublishDir>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
