<Window x:Class="ClickyWindows.CaptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClickyCaptions"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        IsHitTestVisible="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Opacity="0">

    <!-- Subtitles while Clicky talks (Settings > Voice > Captions) -->
    <Border Background="#E6000000" CornerRadius="12" Padding="18,10">
        <TextBlock x:Name="Text" Foreground="White" FontSize="17" FontFamily="Segoe UI"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="820"/>
    </Border>
</Window>
