<Window x:Class="ClickyWindows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicky"
        Width="800"
        Height="640"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource Background}">

    <!-- Borderless dark window like the mac panel; Windows 11 still rounds the corners and draws
         the shadow (SetupWindow.xaml.cs asks DWM for it). The header row drags the window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}"/>
        <Style x:Key="Status" TargetType="TextBlock" BasedOn="{StaticResource HintText}"/>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="Shortcut" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
        </Style>
        <!-- Settings page card (HeyClicky-style grouped options) -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface1}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,6,18,18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <!-- Option row: bold title (Content) + gray description (Tag), switch on the right, divider above -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
                                Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ContentPresenter TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="12" Foreground="{StaticResource TextTertiary}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border x:Name="Track" Grid.Column="1" Width="32" Height="18" CornerRadius="9"
                                        Background="{StaticResource Surface3}" BorderBrush="{StaticResource BorderStrong}"
                                        BorderThickness="1" VerticalAlignment="Center">
                                    <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="1,0,0,0"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,1,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextTertiary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small uppercase header above a group of rows -->
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <!-- Sidebar group header: a disabled tab drawn as a caps label -->
        <Style x:Key="SideGroup" TargetType="TabItem">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <ContentPresenter ContentSource="Header" Margin="10,16,0,6" TextElement.FontSize="11"
                                          TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextTertiary}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tabs as a left sidebar: icon (Tag) + name; the selected page's name is the title,
             its AutomationProperties.HelpText the subtitle; the TabControl's Tag (version) sits at the bottom -->
        <Style x:Key="SideTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Surface1}" BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Margin="20,0,0,14" FontSize="11"
                                               Foreground="{StaticResource TextTertiary}"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    <StackPanel IsItemsHost="True" Margin="10,12"/>
                                </DockPanel>
                            </Border>
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="28,18,28,0"
                                           Foreground="{StaticResource TextPrimary}"
                                           Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <TextBlock DockPanel.Dock="Top" FontSize="12" Margin="28,2,28,14" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextTertiary}"
                                           Text="{Binding SelectedItem.(AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,28,8">
                                    <ContentPresenter ContentSource="SelectedContent"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SideTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="10,8" Margin="0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFont}" FontSize="14" Width="18"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillSubtle}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FillSelected}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
    <DockPanel>
        <!-- Header: status dot + name, like the mac panel -->
        <DockPanel DockPanel.Dock="Top" Margin="18,0,14,0" Height="48">
            <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel"/>
            <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#34D399" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="Clicky" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="HeaderTitle" Foreground="{StaticResource TextTertiary}" FontSize="12" FontWeight="Medium"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderSubtle}"/>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,14">
            <Button x:Name="CancelButton" IsCancel="True" Margin="0,0,8,0" Click="OnCancel"/>
            <Button x:Name="SaveButton" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="84" Click="OnSave"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource BorderSubtle}"/>

        <TabControl x:Name="Tabs" Style="{StaticResource SideTabs}" ItemContainerStyle="{StaticResource SideTab}">
            <!-- General -->
            <TabItem x:Name="GeneralTab" Tag="&#xE713;">
                <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ModelLabel" Style="{StaticResource Section}"/>
                            <ComboBox x:Name="ModelBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="EscalationLabel" Style="{StaticResource Section}"/>
                            <ComboBox x:Name="EscalationBox"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="LanguageLabel" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" MinWidth="200"/>

                    <TextBlock x:Name="GeneralGroup" Style="{StaticResource Group}"/>
                    <CheckBox x:Name="AlwaysCursorBox"/>
                    <CheckBox x:Name="ShowNotchBox"/>
                    <CheckBox x:Name="CopyAnswersBox"/>
                    <CheckBox x:Name="TutorBox"/>
                    <CheckBox x:Name="AutostartBox"/>

                </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="ClickyGroup" Style="{StaticResource SideGroup}" Header="CLICKY"/>

            <!-- Keys -->
            <TabItem x:Name="KeysTab" Tag="&#xE192;">
                <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="IntroText" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <TextBlock x:Name="ClaudeLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="ClaudeTest" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnTestClaude"/>
                        <PasswordBox x:Name="ClaudeKey"/>
                    </DockPanel>
                    <TextBlock x:Name="ClaudeStatus" Style="{StaticResource Status}"/>

                    <TextBlock x:Name="AssemblyLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="AssemblyTest" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnTestAssembly"/>
                        <PasswordBox x:Name="AssemblyKey"/>
                    </DockPanel>
                    <TextBlock x:Name="AssemblyStatus" Style="{StaticResource Status}"/>

                    <TextBlock x:Name="ElevenLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="ElevenTest" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnTestEleven"/>
                        <PasswordBox x:Name="ElevenKey"/>
                    </DockPanel>
                    <TextBlock x:Name="ElevenStatus" Style="{StaticResource Status}"/>
                </StackPanel>
                </Border>
            </TabItem>

            <!-- Voice -->
            <TabItem x:Name="VoiceTab" Tag="&#xE767;">
                <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="VoiceLabel" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="VoiceBox" SelectionChanged="OnVoiceEngineChanged"/>

                    <TextBlock x:Name="VoiceNameLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="PreviewButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnPreview"/>
                        <ComboBox x:Name="VoiceNameBox"/>
                    </DockPanel>
                    <TextBlock x:Name="VoiceNameStatus" Style="{StaticResource Status}"/>

                    <TextBlock x:Name="VoiceSpeedLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <TextBlock x:Name="VoiceSpeedValue" DockPanel.Dock="Right" Width="44" Margin="8,0,0,0" TextAlignment="Right"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <Slider x:Name="VoiceSpeedSlider" Minimum="0.7" Maximum="1.2" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" ValueChanged="OnVoiceSpeedChanged"/>
                    </DockPanel>

                </StackPanel>
                </Border>
            </TabItem>

            <!-- Microphone -->
            <TabItem x:Name="MicTab" Tag="&#xE720;">
                <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="MicLabel" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="MicBox" SelectionChanged="OnMicChanged"/>
                    <ProgressBar x:Name="MicLevel" Height="6" Margin="0,8,0,0" Maximum="1"/>
                    <TextBlock x:Name="MicHint" Style="{StaticResource Status}"/>
                </StackPanel>
                </Border>
            </TabItem>

            <!-- Dictation -->
            <TabItem x:Name="DictationTab" Tag="&#xE70F;">
                <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="DictationGroup" Style="{StaticResource Group}"/>
                        <CheckBox x:Name="CleanupBox"/>
                        <CheckBox x:Name="LearnBox"/>
                        <CheckBox x:Name="RecordBox"/>
                        <DockPanel>
                            <Button x:Name="ReportButton" DockPanel.Dock="Left" Click="OnAccuracyReport"/>
                            <TextBlock x:Name="ReportStatus" Style="{StaticResource Status}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="DictionaryLabel" Style="{StaticResource Section}" Margin="0,16,0,4"/>
                    </StackPanel>
                    <TextBlock x:Name="DictionaryHint" DockPanel.Dock="Bottom" Style="{StaticResource Status}"/>
                    <TextBox x:Name="DictionaryBox" Height="200" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </DockPanel>
                </Border>
            </TabItem>

            <!-- Shortcuts -->
            <TabItem x:Name="ShortcutsTab" Tag="&#xE765;">
                <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="AskLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="AskReset" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutReset"/>
                        <Button x:Name="AskChange" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnShortcutChange"/>
                        <TextBox x:Name="AskBox" Style="{StaticResource Shortcut}"/>
                    </DockPanel>

                    <TextBlock x:Name="DictateLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="DictateOff" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutOff"/>
                        <Button x:Name="DictateReset" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutReset"/>
                        <Button x:Name="DictateChange" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnShortcutChange"/>
                        <TextBox x:Name="DictateBox" Style="{StaticResource Shortcut}"/>
                    </DockPanel>

                    <TextBlock x:Name="WriteLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="WriteOff" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutOff"/>
                        <Button x:Name="WriteReset" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutReset"/>
                        <Button x:Name="WriteChange" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnShortcutChange"/>
                        <TextBox x:Name="WriteBox" Style="{StaticResource Shortcut}"/>
                    </DockPanel>

                    <TextBlock x:Name="PromptLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="PromptOff" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutOff"/>
                        <Button x:Name="PromptReset" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutReset"/>
                        <Button x:Name="PromptChange" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnShortcutChange"/>
                        <TextBox x:Name="PromptBox" Style="{StaticResource Shortcut}"/>
                    </DockPanel>

                    <TextBlock x:Name="ShortcutStatus" Style="{StaticResource Status}" Margin="0,10,0,0"/>
                    <TextBlock x:Name="ShortcutHelp" Style="{StaticResource Status}" Margin="0,10,0,0"/>
                </StackPanel>
                </Border>
            </TabItem>

            <TabItem x:Name="WorkGroup" Style="{StaticResource SideGroup}" Header="WORK"/>

            <!-- Agent (computer use) -->
            <TabItem x:Name="AgentTab" Tag="&#xE99A;">
                <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Computer use -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="AgentModelLabel" Style="{StaticResource Section}"/>
                            <ComboBox x:Name="AgentModelBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="AgentCostLabel" Style="{StaticResource Section}"/>
                            <ComboBox x:Name="AgentCostBox"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="AgentGroup" Style="{StaticResource Group}"/>
                    <CheckBox x:Name="AgentAlwaysBox"/>
                    <CheckBox x:Name="AgentQuietBox"/>
                    <CheckBox x:Name="SessionDuckingBox"/>
                </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
    </Border>
</Window>
