<Window x:Class="ClickyWindows.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicky"
        Width="560"
        Height="620"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}"
        Background="{StaticResource Background}">

    <!-- Borderless dark window like the mac panel; Windows 11 still rounds the corners and draws
         the shadow (SetupWindow.xaml.cs asks DWM for it). The header row drags the window. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}"/>
        <Style x:Key="Status" TargetType="TextBlock" BasedOn="{StaticResource HintText}"/>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="Shortcut" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource AccentText}"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
    <DockPanel>
        <!-- Header: status dot + name, like the mac panel -->
        <DockPanel DockPanel.Dock="Top" Margin="18,0,14,0" Height="48">
            <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" VerticalAlignment="Center"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel"/>
            <Ellipse Width="8" Height="8" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#34D399" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                </Ellipse.Effect>
            </Ellipse>
            <TextBlock Text="Clicky" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="HeaderTitle" Foreground="{StaticResource TextTertiary}" FontSize="12" FontWeight="Medium"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </DockPanel>
        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderSubtle}" Margin="16,0"/>

        <!-- Footer -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,14">
            <Button x:Name="CancelButton" IsCancel="True" Margin="0,0,8,0" Click="OnCancel"/>
            <Button x:Name="SaveButton" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="84" Click="OnSave"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource BorderSubtle}" Margin="16,0"/>

        <TabControl x:Name="Tabs" Margin="16,16,16,12" Padding="2,4,2,0">
            <!-- Keys -->
            <TabItem x:Name="KeysTab">
                <StackPanel>
                    <TextBlock x:Name="IntroText" Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <TextBlock x:Name="ClaudeLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="ClaudeTest" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnTestClaude"/>
                        <PasswordBox x:Name="ClaudeKey"/>
                    </DockPanel>
                    <TextBlock x:Name="ClaudeStatus" Style="{StaticResource Status}"/>

                    <TextBlock x:Name="AssemblyLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="AssemblyTest" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnTestAssembly"/>
                        <PasswordBox x:Name="AssemblyKey"/>
                    </DockPanel>
                    <TextBlock x:Name="AssemblyStatus" Style="{StaticResource Status}"/>

                    <TextBlock x:Name="ElevenLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="ElevenTest" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnTestEleven"/>
                        <PasswordBox x:Name="ElevenKey"/>
                    </DockPanel>
                    <TextBlock x:Name="ElevenStatus" Style="{StaticResource Status}"/>
                </StackPanel>
            </TabItem>

            <!-- Voice -->
            <TabItem x:Name="VoiceTab">
                <StackPanel>
                    <TextBlock x:Name="VoiceLabel" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="VoiceBox" SelectionChanged="OnVoiceEngineChanged"/>

                    <TextBlock x:Name="VoiceNameLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="PreviewButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnPreview"/>
                        <ComboBox x:Name="VoiceNameBox"/>
                    </DockPanel>
                    <TextBlock x:Name="VoiceNameStatus" Style="{StaticResource Status}"/>

                    <TextBlock x:Name="VoiceSpeedLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <TextBlock x:Name="VoiceSpeedValue" DockPanel.Dock="Right" Width="44" Margin="8,0,0,0" TextAlignment="Right"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <Slider x:Name="VoiceSpeedSlider" Minimum="0.7" Maximum="1.2" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" ValueChanged="OnVoiceSpeedChanged"/>
                    </DockPanel>

                    <TextBlock x:Name="MicLabel" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="MicBox" SelectionChanged="OnMicChanged"/>
                    <ProgressBar x:Name="MicLevel" Height="6" Margin="0,8,0,0" Maximum="1"/>
                    <TextBlock x:Name="MicHint" Style="{StaticResource Status}"/>
                </StackPanel>
            </TabItem>

            <!-- Shortcuts -->
            <TabItem x:Name="ShortcutsTab">
                <StackPanel>
                    <TextBlock x:Name="AskLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="AskReset" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutReset"/>
                        <Button x:Name="AskChange" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnShortcutChange"/>
                        <TextBox x:Name="AskBox" Style="{StaticResource Shortcut}"/>
                    </DockPanel>

                    <TextBlock x:Name="DictateLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="DictateOff" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutOff"/>
                        <Button x:Name="DictateReset" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutReset"/>
                        <Button x:Name="DictateChange" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnShortcutChange"/>
                        <TextBox x:Name="DictateBox" Style="{StaticResource Shortcut}"/>
                    </DockPanel>

                    <TextBlock x:Name="WriteLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="WriteOff" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutOff"/>
                        <Button x:Name="WriteReset" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutReset"/>
                        <Button x:Name="WriteChange" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnShortcutChange"/>
                        <TextBox x:Name="WriteBox" Style="{StaticResource Shortcut}"/>
                    </DockPanel>

                    <TextBlock x:Name="PromptLabel" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <Button x:Name="PromptOff" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutOff"/>
                        <Button x:Name="PromptReset" DockPanel.Dock="Right" Margin="6,0,0,0" MinWidth="0" Click="OnShortcutReset"/>
                        <Button x:Name="PromptChange" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnShortcutChange"/>
                        <TextBox x:Name="PromptBox" Style="{StaticResource Shortcut}"/>
                    </DockPanel>

                    <TextBlock x:Name="ShortcutStatus" Style="{StaticResource Status}" Margin="0,10,0,0"/>
                    <TextBlock x:Name="ShortcutHelp" Style="{StaticResource Status}" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>

            <!-- Dictation -->
            <TabItem x:Name="DictationTab">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <CheckBox x:Name="CleanupBox"/>
                        <CheckBox x:Name="LearnBox"/>
                        <TextBlock x:Name="DictionaryLabel" Style="{StaticResource Section}" Margin="0,16,0,4"/>
                    </StackPanel>
                    <TextBlock x:Name="DictionaryHint" DockPanel.Dock="Bottom" Style="{StaticResource Status}"/>
                    <TextBox x:Name="DictionaryBox" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </DockPanel>
            </TabItem>

            <!-- General -->
            <TabItem x:Name="GeneralTab">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ModelLabel" Style="{StaticResource Section}"/>
                            <ComboBox x:Name="ModelBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="EscalationLabel" Style="{StaticResource Section}"/>
                            <ComboBox x:Name="EscalationBox"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="LanguageLabel" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" MinWidth="200"/>

                    <CheckBox x:Name="AlwaysCursorBox" Margin="0,16,0,0"/>
                    <CheckBox x:Name="CopyAnswersBox"/>
                    <CheckBox x:Name="TutorBox"/>
                    <CheckBox x:Name="AutostartBox"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
    </Border>
</Window>
