<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 LTS. No WinRT APIs are used, so no Windows SDK projection (saves ~25 MB of output) -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms for NotifyIcon (system tray) and System.Drawing screen capture -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ClickyWindows</AssemblyName>
    <RootNamespace>ClickyWindows</RootNamespace>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Per-monitor DPI v2 — WPF handles this; must NOT also be in app.manifest -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official Claude SDK -->
    <PackageReference Include="Anthropic" Version="12.55.0" />
    <!-- Real-time WASAPI audio capture + MP3 playback -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <!-- Free offline Windows voices (SAPI) when ElevenLabs is not configured -->
    <PackageReference Include="System.Speech" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped defaults: prompts, hotkey, endpoints, models. User choices live in %APPDATA% -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
