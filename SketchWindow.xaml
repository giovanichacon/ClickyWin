<Window x:Class="ClickyWindows.SketchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClickySketch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        IsHitTestVisible="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="-9999" Top="-9999" Width="10" Height="10">

    <!-- Teacher mode drawings over the screen with the cursor: drag traces, key caps, highlight circles -->
    <Canvas x:Name="Board"/>
</Window>
