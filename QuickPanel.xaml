<Window x:Class="ClickyWindows.QuickPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicky Panel"
        Width="344"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimary}">

    <!-- Layout and sizes follow the mac CompanionPanelView: 320 pt wide dark card, header with a
         glowing status dot, hairline dividers, footer with Quit. The 12 px margin holds the shadow. -->
    <Border Style="{StaticResource PanelBorder}" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.5"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="16,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" VerticalAlignment="Center"
                        Margin="10,0,0,0" Click="OnClose"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"
                           Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="StatusGlow" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="Clicky" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="16,0"/>

            <StackPanel Margin="16,16,16,0">
                <TextBlock x:Name="HoldText" FontSize="12" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                <TextBlock x:Name="ShortcutsText" Style="{StaticResource HintText}"/>

                <!-- Last answer card -->
                <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource FillSubtle}"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="CopyAnswerButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Click="OnCopyAnswer"/>
                            <TextBlock x:Name="AnswerLabel" Style="{StaticResource CapsLabel}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="QuestionText" Foreground="{StaticResource TextTertiary}" FontSize="11"
                                   FontStyle="Italic" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   MaxHeight="32" Margin="0,6,0,0"/>
                        <TextBox x:Name="AnswerText" IsReadOnly="True" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{StaticResource TextSecondary}" Background="Transparent"
                                 BorderThickness="0" Padding="0" Margin="0,6,0,0" MaxHeight="150"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="DictationsLabel" Style="{StaticResource CapsLabel}" Margin="0,16,0,6"/>
                <ListBox x:Name="DictationList" MaxHeight="170" BorderThickness="0" Background="Transparent"
                         Margin="-8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnDictationPicked">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           MaxHeight="34" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{StaticResource TextTertiary}"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <CheckBox x:Name="TutorBox" Margin="0,14,0,0" FontSize="12" Click="OnTutorToggled"/>
            </StackPanel>

            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="16,14,16,0"/>

            <!-- Footer -->
            <DockPanel Margin="12,10">
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnSettings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock x:Name="SettingsText"/>
                    </StackPanel>
                </Button>
                <Button x:Name="QuitButton" Style="{StaticResource IconButton}" HorizontalAlignment="Left" Click="OnQuit">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,1,6,0"/>
                        <TextBlock x:Name="QuitText"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
